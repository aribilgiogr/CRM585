@model IEnumerable<CustomerListItemDto>
@{
    ViewData["Title"] = "Müşteriler";
}

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>İsim</th>
            <th>Durum</th>
            <th>Tipi</th>
            <th>Atanan</th>
            <th>Etkinlik Sayısı</th>
            <th>Fırsat Sayısı</th>
            <th class="text-end">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Status</td>
                    <td>@(customer.Individual ? "Bireysel" : "Kurumsal")</td>
                    <td>@customer.AssignedUserName</td>
                    <td>@customer.ActivityCount</td>
                    <td>@customer.OpportunityCount</td>
                    <td class="text-end">
                        <a asp-controller="customers" asp-action="details" asp-route-id="@customer.Id" class="btn btn-primary btn-sm">Detaylar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">Kayıtlı müşteri bulunamadı.</td>
            </tr>
        }
    </tbody>
</table>

