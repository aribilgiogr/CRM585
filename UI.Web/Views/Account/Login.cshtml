@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Formu";
    Layout = "_AuthLayout";
}
<form asp-action="login" asp-controller="account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="card bg-light shadow-sm rounded-0 border-info">
            <div class="card-header text-center">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                @Html.AntiForgeryToken()
                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                <div class="form-floating mb-3">
                    <input class="form-control" asp-for="Email" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="form-floating">
                    <input class="form-control" asp-for="Password" />
                    <label asp-for="Password">Password</label>
                    <div class="d-flex justify-content-between align-items-center">
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <a asp-action="forgotpassword" asp-controller="account" class="link-secondary small">
                            Parolamı Unuttum!
                        </a>
                    </div>

                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <button class="btn btn-info btn-sm" type="submit">Giriş Yap</button>
                    <div class="form-check">
                        <input class="form-check-input" asp-for="RememberMe">
                        <label class="form-check-label" asp-for="RememberMe"></label>
                    </div>
                </div>
                <div class="text-center">
                    <small class="text-muted">
                        Henüz kayıtlı değil misiniz?
                        <a asp-action="register" asp-controller="account" class="link-primary text-decoration-none fw-semibold">Kayıt olun!</a>
                    </small>
                </div>
            </div>
</form>
