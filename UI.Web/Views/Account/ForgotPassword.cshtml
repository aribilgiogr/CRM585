@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Parolamı Unuttum";
    Layout = "_AuthLayout";
}
<form asp-action="forgotpassword" asp-controller="account" method="post" class="card bg-light shadow-sm rounded-0 border-info">
    <div class="card-header text-center">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
        <div class="form-floating mb-3">
            <input class="form-control" asp-for="Email" />
            <label asp-for="Email"></label>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="form-floating mb-3">
            <input class="form-control" asp-for="ConfirmEmail" />
            <label asp-for="ConfirmEmail"></label>
            <span asp-validation-for="ConfirmEmail" class="text-danger small"></span>
        </div>
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-danger btn-sm" type="submit">Sıfırla</button>
        </div>
        <div class="text-center">
            <small class="text-muted d-block">
                Henüz kayıtlı değil misiniz?
                <a asp-action="register" asp-controller="account" class="link-primary text-decoration-none fw-semibold">Kayıt olun!</a>
            </small>
            <small class="text-muted d-block">
                Zaten kayıtlı mısınız??
                <a asp-action="login" asp-controller="account" class="link-primary text-decoration-none fw-semibold">Giriş yapın!</a>
            </small>
        </div>
    </div>
</form>
