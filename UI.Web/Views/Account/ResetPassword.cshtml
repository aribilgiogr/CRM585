@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Parola Yenileme Formu";
    Layout = "_AuthLayout";
}

<form asp-action="resetpassword" asp-controller="account" method="post" class="card bg-light shadow-sm rounded-0 border-info">
    <div class="card-header text-center">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Token" />
        <div class="form-floating mb-3">
            <input class="form-control" asp-for="Email" />
            <label asp-for="Email"></label>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="form-floating mb-3">
            <input class="form-control" asp-for="Password" />
            <label asp-for="Password"></label>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-floating">
            <input class="form-control" asp-for="ConfirmPassword" />
            <label asp-for="ConfirmPassword"></label>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-info btn-sm" type="submit">Parolayı Değiştir</button>
        </div>
    </div>
</form>