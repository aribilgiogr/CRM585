@model RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Formu";
    Layout = "_AuthLayout";
}


        <form asp-action="register" asp-controller="account" method="post" class="card bg-light shadow-sm rounded-0 border-info">
            <div class="card-header text-center">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                @Html.AntiForgeryToken()
                <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                <div class="form-floating mb-3">
                    <input class="form-control" asp-for="FirstName" />
                    <label asp-for="FirstName"></label>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="form-floating mb-3">
                    <input class="form-control" asp-for="LastName" />
                    <label asp-for="LastName"></label>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
                <div class="form-floating mb-3">
                    <input class="form-control" asp-for="Email" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="form-floating mb-3">
                    <input class="form-control" asp-for="Password" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-floating">
                    <input class="form-control" asp-for="ConfirmPassword" />
                    <label asp-for="ConfirmPassword"></label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <button class="btn btn-info btn-sm" type="submit">Kayıt Ol</button>
                </div>
                <div class="text-center">
                    <small class="text-muted">
                        Zaten kayıtlı mısınız??
                        <a asp-action="login" asp-controller="account" class="link-primary text-decoration-none fw-semibold">Giriş yapın!</a>
                    </small>
                </div>
            </div>
        </form>
