@using System.Security.Claims
@model IEnumerable<LeadListItemDto>
@{
    ViewData["Title"] = "Veriler";
    string currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
}

@if(User.IsInRole("ADM"))
{
    <div class="d-flex justify-content-start">
        <a asp-controller="Leads" asp-action="Create" class="btn btn-primary btn-sm me-3">Yeni Veri Ekle</a>
        <form asp-controller="leads" asp-action="import" method="post" enctype="multipart/form-data" class="d-inline">
            <div class=" input-group input-group-sm">
                <input type="file" name="file" accept=".json, .csv, .xlsx" class="form-control" />
                <button type="submit" class="btn btn-outline-secondary btn-sm">Yükle</button>
            </div>
        </form>   
    </div>
}

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>İsim</th>
            <th>Telefon Numarası</th>
            <th>Kaynak</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var lead in Model)
            {
                <tr>
                    <td>@lead.Name</td>
                    <td>@lead.PhoneNumber</td>
                    <td>@lead.Source</td>
                    <td>@lead.Status</td>
                    <td>
                        @if (User.IsInRole("ADM"))
                        {
                            @lead.AssignedUserName
                        }
                        else
                        {
                            if (lead.AssignedUserId != currentUserId)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="assignLead('@lead.Id')">Atama Yap</button>
                            }
                            else
                            {
                                <div class="d-flex justify-content-end">
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@lead.Id" class="btn btn-primary btn-sm me-3">Detaylar</a>
                                    <div class="dropdown">
                                      <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Etkinlikler
                                      </button>
                                      <ul class="dropdown-menu">
                                            @foreach(var item in Html.GetEnumSelectList<ActivityType>())
                                            {
                                                <li>
                                                    <button class="dropdown-item" type="button" onclick="addLeadActivity('@item.Value', '@lead.Id')">@item.Text</button>
                                                </li>
                                            }
                                      </ul>
                                    </div>  
                                </div>
                            }
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">Veri bulunamadı.</td>
            </tr>
        }
    </tbody>
</table>

